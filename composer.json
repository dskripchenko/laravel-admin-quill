{
    "name": "dskripchenko/laravel-admin-quill",
    "description": "Quill as an alternative WYSIWYG engine for dskripchenko/laravel-admin.",
    "type": "library",
    "keywords": [
        "laravel",
        "admin",
        "wysiwyg",
        "quill",
        "rich-text",
        "editor",
        "dskripchenko"
    ],
    "homepage": "https://github.com/dskripchenko/laravel-admin-quill",
    "license": "MIT",
    "authors": [
        {
            "name": "Denis Skripchenko",
            "email": "denskrp90@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/dskripchenko/laravel-admin-quill/issues",
        "source": "https://github.com/dskripchenko/laravel-admin-quill"
    },
    "require": {
        "php": "^8.2",
        "dskripchenko/laravel-admin": "^1.7"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Dskripchenko\\LaravelAdminQuill\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dskripchenko\\LaravelAdminQuill\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dskripchenko\\LaravelAdminQuill\\AdminQuillServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "abandoned": "dskripchenko/laravel-admin"
}
